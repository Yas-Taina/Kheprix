# DB
POSTGRES_USER=root
POSTGRES_PASSWORD=senha_local
POSTGRES_DB=kheprix_oltp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5410

# DW
POSTGRES_DW_USER=user
POSTGRES_DW_PASSWORD=tcc_kheprix_2026
POSTGRES_DW_DB=kheprix_dw_db
POSTGRES_DW_HOST=db_dw
POSTGRES_DW_PORT=5432

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD="sua senha do app"
SMTP_DOMAIN=gmail.com
SMTP_AUTH=plain
SMTP_STARTTLS=true
EMAIL_REMETENTE=noreply@kheprix.com

# Frontend 
FRONTEND_URL=http://localhost:4200
REDEFINICAO_SENHA_CAMINHO=/redefinir-senha

# Chatbot IA (Groq — Llama 3.3 70B)
# Obtenha a chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Autenticação serviço-a-serviço (Rails → Chatbot)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
CHATBOT_INTERNAL_KEY=gere_uma_chave_segura_aqui

# Usuário read-only dedicado ao chatbot no DW (criado pela migração DW)
# Princípio do menor privilégio: só SELECT em indicadores_dashboard e analises_estatisticas
POSTGRES_DW_CHATBOT_USER=kheprix_chatbot_ro
POSTGRES_DW_CHATBOT_PASSWORD=chatbot_senha_local

# URL interna do serviço chatbot (usada pelo Rails para proxy)
CHATBOT_URL=http://chatbot:8001

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_DB_UPGRADE=true
_AIRFLOW_WWW_USER_CREATE=true

# Airflow Connections (Variables vs Docker Networking Constraints)
# NOTA: O OLTP não herda o ${POSTGRES_HOST} local pois a porta e hostname são diferentes dentro da malha bridge do Docker.
AIRFLOW_DB_OLTP_HOST=db
AIRFLOW_DB_OLTP_PORT=5432

# Airflow Connections URIs
AIRFLOW_CONN_DB_OLTP=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${AIRFLOW_DB_OLTP_HOST}:${AIRFLOW_DB_OLTP_PORT}/${POSTGRES_DB}
AIRFLOW_CONN_DB_DW=postgresql://${POSTGRES_DW_USER}:${POSTGRES_DW_PASSWORD}@${POSTGRES_DW_HOST}:${POSTGRES_DW_PORT}/${POSTGRES_DW_DB}
