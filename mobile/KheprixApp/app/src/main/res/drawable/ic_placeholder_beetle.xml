        android:strokeColor="#6B7A5E"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M180,120 L215,105"/>

    <!-- Perna traseira esquerda -->
    <path
        android:strokeColor="#6B7A5E"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M90,200 L55,220"/>

    <!-- Perna traseira direita -->
    <path
        android:strokeColor="#6B7A5E"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M190,200 L225,220"/>

    <!-- Antenas -->
    <path
        android:strokeColor="#6B7A5E"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M130,80 C120,60 105,45 95,30"/>

    <path
        android:strokeColor="#6B7A5E"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M150,80 C160,60 175,45 185,30"/>

</vector>
