<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_registro_rapido.xml
    4 spinners em cascata: Estudo → Campanha → Unidade Amostral → Evento
    Botão "Prosseguir" navega para o formulário de registro em si.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="40dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Cadastro Rápido de Registros"
                android:textSize="26sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:layout_marginTop="20dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- Spinner Estudo -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Estudo:" android:textSize="16sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <Spinner android:id="@+id/spinnerEstudo"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green" android:paddingStart="12dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

            <!-- Spinner Campanha -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Campanha de Coleta:" android:textSize="16sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <Spinner android:id="@+id/spinnerCampanha"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green" android:paddingStart="12dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

            <!-- Spinner Unidade Amostral -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Unidade Amostral:" android:textSize="16sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <Spinner android:id="@+id/spinnerUnidade"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green" android:paddingStart="12dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

            <!-- Spinner Evento de Amostragem -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Evento de Amostragem:" android:textSize="16sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <Spinner android:id="@+id/spinnerEvento"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green" android:paddingStart="12dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="32dp"/>

            <Button android:id="@+id/btnProsseguir"
                android:layout_width="wrap_content" android:layout_height="52dp"
                android:text="Prosseguir" android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
