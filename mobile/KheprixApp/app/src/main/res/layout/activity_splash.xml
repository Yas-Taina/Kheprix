<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_splash.xml — Tela de Splash
    Fundo bege com logo centralizado e nome do app.

    SUBSTITUIR:
    - @drawable/ic_placeholder_beetle → @drawable/kheprix_logo (logo alado do header)
    - Fonte: android:fontFamily="serif" → @font/cormorant_garamond_light
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE9DE">

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_placeholder_beetle"
        android:scaleType="fitCenter"
        android:alpha="0.75"
        android:contentDescription="Kheprix Logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSplashTitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45"/>

    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KHEPRIX"
        android:textSize="42sp"
        android:textColor="#6B7A5E"
        android:letterSpacing="0.25"
        android:fontFamily="serif"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSplashLogo"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
