<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_base_drawer.xml
    Layout raiz com DrawerLayout para o menu hamburguer.
    Não é usado diretamente — serve como referência de estrutura.
    
    Para integrar o drawer em qualquer activity que herda BaseDrawerActivity:
    Envolva o conteúdo principal com este DrawerLayout.
    O NavigationView já inclui o drawer_menu.xml definido em res/menu/.
    
    SUBSTITUIR no header:
    @drawable/ic_placeholder_beetle → @drawable/ic_menu (hamburguer)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Conteúdo principal (substituir pelo conteúdo da activity) -->
    <FrameLayout
        android:id="@+id/contentMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Navigation Drawer (desliza da esquerda) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#EDE9DE"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="#4A5240"
        app:itemIconTint="#6B7A5E"
        app:itemTextAppearance="@style/KheprixNavItem">

        <!-- Header do drawer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#A8B89A"
            android:padding="24dp"
            android:paddingTop="40dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_placeholder_beetle"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kheprix"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KHEPRIX"
                android:textSize="20sp"
                android:textColor="#4A5240"
                android:fontFamily="serif"
                android:letterSpacing="0.2"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
