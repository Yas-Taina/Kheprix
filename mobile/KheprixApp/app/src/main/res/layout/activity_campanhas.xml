<?xml version="1.0" encoding="utf-8"?>
<!-- activity_campanhas.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">

        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <!-- Título duplo: Nome do Estudo + subtítulo -->
            <TextView android:id="@+id/tvEstudoNome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nome do Estudo"
                android:textSize="20sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center"
                android:layout_marginTop="16dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Campanhas de Coleta de Dados"
                android:textSize="26sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center"
                android:layout_marginTop="4dp"/>

            <!-- Ornamento -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- Botão Adicionar Campanha -->
            <Button android:id="@+id/btnAdicionarCampanha"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Adicionar Campanha  ⊕"
                android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCampanhas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
