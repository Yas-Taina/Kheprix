<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDE9DE">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#A8B89A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivMenuLateral"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_menu"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:tint="@color/kheprix_bg"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="95dp"
            android:src="@drawable/ic_header_beetle"
            android:alpha="0.7"
            android:contentDescription="Kheprix"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/ivPerfil"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_profile"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:tint="@color/kheprix_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cadastro de Espécies"
                android:textSize="26sp"
                android:textColor="#4A5240"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginTop="20dp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_divider_ornament"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/kheprix_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto:"
                android:textSize="16sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvNomeFoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Selecione uma foto"
                    android:textSize="14sp"
                    android:textColor="#4A5240"
                    android:paddingStart="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivSelecionarGaleria"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivSelecionarGaleria"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_folder"
                    android:scaleType="fitCenter"
                    android:contentDescription="Galeria"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/kheprix_green"
                    app:layout_constraintEnd_toStartOf="@id/ivAbrirCamera"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/ivAbrirCamera"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_camera"
                    android:scaleType="fitCenter"
                    android:contentDescription="Câmera"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/kheprix_green"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/ivPreviewFoto"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:contentDescription="Preview da foto"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <ImageView
                android:id="@+id/ivRotarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_rotate_right"
                android:padding="10dp"
                android:contentDescription="Girar foto"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/kheprix_green"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classe:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etClasse"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Classe"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ordem:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etOrdem"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Ordem"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Família:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etFamilia"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Familia"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gênero:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etGenero"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Genero"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Espécie:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etEspecie"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Espécie"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome Popular:"
                        android:textSize="14sp"
                        android:textColor="#6B7A5E"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/etNomePopular"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#4A5240"
                        android:hint="Nome Popular"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status de Conservação:"
                android:textSize="14sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:layout_marginTop="4dp" />

            <CheckBox
                android:id="@+id/checkEndemismo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A espécie é nativa da região"
                android:textSize="15sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"
                android:buttonTint="#6B7A5E"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="Confirmar"
        android:textColor="#FFFFFF"
        android:fontFamily="serif"
        android:backgroundTint="#6B7A5E"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
