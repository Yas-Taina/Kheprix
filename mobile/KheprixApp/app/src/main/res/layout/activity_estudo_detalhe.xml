<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDE9DE">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#A8B89A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_menu" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:tint="@color/kheprix_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:layout_width="120dp" android:layout_height="95dp"
            android:src="@drawable/ic_header_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_profile" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:tint="@color/kheprix_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#EDE9DE"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp"
                android:layout_marginTop="20dp"
                style="@style/Widget.MaterialComponents.CardView">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="16dp" android:paddingBottom="16dp">

                    <TextView android:id="@+id/tvEstudoNome"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Nome do Estudo"
                        android:textSize="22sp" android:textColor="#4A5240"
                        android:fontFamily="serif" android:gravity="center"
                        android:letterSpacing="0.05"/>

                    <TextView android:id="@+id/tvRegistrosOffline"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="0 Registros Offline"
                        android:textSize="18sp" android:textColor="#4A5240"
                        android:fontFamily="serif" android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                    <Button android:id="@+id/btnSincronizar"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="Sincronizar Dados"
                        android:textColor="#FFFFFF" android:fontFamily="serif"
                        android:backgroundTint="#6B7A5E"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button android:id="@+id/btnVisualizarDetalhes"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Visualizar Detalhes"
                android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDetalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="#EDE9DE"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp"
                android:layout_marginTop="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Nome:" android:textSize="13sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvDetalheNome"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="#4A5240"
                        android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Observações:" android:textSize="13sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvDetalheObs"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="#4A5240"
                        android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Seu perfil:" android:textSize="13sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvDetalhePerfil"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="#4A5240"
                        android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Criado em:" android:textSize="13sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvDetalheCriado"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="#4A5240"
                        android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Atualizado em:" android:textSize="13sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvDetalheAtualizado"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="#4A5240"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_gravity="center"
                android:layout_marginTop="8dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCampanhas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#EDE9DE" app:cardElevation="2dp"
                app:cardCornerRadius="8dp" android:layout_marginTop="12dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp">

                    <ImageView android:layout_width="80dp" android:layout_height="80dp"
                        android:src="@drawable/ic_butterfly" android:scaleType="fitCenter"
                        android:alpha="0.6" android:contentDescription="Campanhas"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Visualizar\nCampanhas"
                        android:textSize="18sp" android:textColor="#4A5240"
                        android:fontFamily="serif" android:layout_marginStart="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEspecies"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#EDE9DE" app:cardElevation="2dp"
                app:cardCornerRadius="8dp" android:layout_marginTop="8dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp">

                    <ImageView android:layout_width="80dp" android:layout_height="80dp"
                        android:src="@drawable/ic_bee" android:scaleType="fitCenter"
                        android:alpha="0.6" android:contentDescription="Espécies"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Visualizar\nEspécies"
                        android:textSize="18sp" android:textColor="#4A5240"
                        android:fontFamily="serif" android:layout_marginStart="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCadastrarEspecie"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="#EDE9DE" app:cardElevation="2dp"
                app:cardCornerRadius="8dp" android:layout_marginTop="8dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp">

                    <ImageView android:layout_width="80dp" android:layout_height="80dp"
                        android:src="@drawable/ic_ladybug" android:scaleType="fitCenter"
                        android:alpha="0.6" android:contentDescription="Cadastrar Espécie"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cadastrar\nEspécie"
                        android:textSize="18sp" android:textColor="#4A5240"
                        android:fontFamily="serif" android:layout_marginStart="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
