<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A8B89A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CADASTRE-SE"
            android:textSize="34sp"
            android:textColor="#4A5240"
            android:letterSpacing="0.15"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/ivBesouro"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:src="@drawable/kheprix_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Ilustração do besouro"
            android:alpha="0.5"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvInstrucao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Faça seu cadastro gratuitamente para ter acesso ao sistema.\nJá tem uma conta? Faça seu login "
            android:textSize="13sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivBesouro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tvLinkLogin"/>

        <TextView
            android:id="@+id/tvLinkLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="aqui."
            android:textSize="13sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/tvInstrucao"
            app:layout_constraintBottom_toBottomOf="@id/tvInstrucao"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tvLabelNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome:"
            android:textSize="17sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"
            android:layout_marginStart="64dp"
            app:layout_constraintTop_toBottomOf="@id/tvInstrucao"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/etNome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:inputType="textPersonName|textCapWords"
            android:background="@drawable/bg_field_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#4A5240"
            android:textCursorDrawable="@null"
            android:importantForAutofill="no"
            android:layout_marginTop="4dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelNome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvLabelEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-mail:"
            android:textSize="17sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"
            android:layout_marginStart="64dp"
            app:layout_constraintTop_toBottomOf="@id/etNome"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_field_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#4A5240"
            android:textCursorDrawable="@null"
            android:importantForAutofill="no"
            android:layout_marginTop="4dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvLabelSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senha:"
            android:textSize="17sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"
            android:layout_marginStart="64dp"
            app:layout_constraintTop_toBottomOf="@id/etEmail"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:inputType="textPassword"
            android:background="@drawable/bg_field_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#4A5240"
            android:textCursorDrawable="@null"
            android:layout_marginTop="4dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvLabelConfirmarSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirme a senha:"
            android:textSize="17sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"
            android:layout_marginStart="64dp"
            app:layout_constraintTop_toBottomOf="@id/etSenha"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/etConfirmarSenha"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:inputType="textPassword"
            android:background="@drawable/bg_field_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#4A5240"
            android:textCursorDrawable="@null"
            android:layout_marginTop="4dp"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="64dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelConfirmarSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Confirmar"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="serif"
            android:backgroundTint="#6B7A5E"
            android:layout_marginTop="20dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            app:layout_constraintTop_toBottomOf="@id/etConfirmarSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="#4A5240"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnConfirmar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
