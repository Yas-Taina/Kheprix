<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etNomeVariavel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#4A5240"
                android:hint="Nome da Variável"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nível de Estudo"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace" />

            <Spinner
                android:id="@+id/spinnerNivelAplicacao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Métrica"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etMetrica"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#4A5240"
                android:hint="Ex: °C"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Dado"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace" />

            <Spinner
                android:id="@+id/spinnerTipoDado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivRemoverVariavel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close_circle"
            android:scaleType="fitCenter"
            android:contentDescription="Remover variável"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6dp"
            app:tint="@color/kheprix_red" />
    </LinearLayout>
</LinearLayout>
