<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de formulário de variável (inflado dinamicamente em NovoEstudoActivity).
    Cada linha tem: Nome, Nível de Estudo (spinner), Métrica, Tipo de Dado (spinner), botão ✕

    SUBSTITUIR:
    - ic_placeholder_beetle → ic_close_circle (#B88A8A, círculo vermelho com ✕)
      que representa o botão de remover variável do design
    - Spinners: estilize via theme para ter a seta ▼ do design
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <!-- Linha 1: Nome | Nível de Estudo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <EditText
                android:id="@+id/etNomeVariavel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#4A5240"
                android:hint="Placeholder"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nível de Estudo"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <!--
                Spinner "Nível de Estudo"
                OPÇÕES (res/values/arrays.xml):
                  <string-array name="niveis_aplicacao">
                    <item>Campanha</item>
                    <item>Unidade</item>
                    <item>Evento</item>
                    <item>Registro</item>
                  </string-array>
            -->
            <Spinner
                android:id="@+id/spinnerNivelAplicacao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Linha 2: Métrica | Tipo de Dado | ✕ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Métrica"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <EditText
                android:id="@+id/etMetrica"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#4A5240"
                android:hint="°C"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Dado"
                android:textSize="12sp"
                android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <!--
                Spinner "Tipo de Dado"
                OPÇÕES (res/values/arrays.xml):
                  <string-array name="tipos_dado">
                    <item>Numérico</item>
                    <item>Texto</item>
                    <item>Booleano</item>
                  </string-array>
            -->
            <Spinner
                android:id="@+id/spinnerTipoDado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="10dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Botão ✕ remover variável
             SUBSTITUIR: @drawable/ic_close_circle (círculo #B88A8A com X branco)
             Tamanho: 36×36dp alinhado ao centro vertical -->
        <ImageView
            android:id="@+id/ivRemoverVariavel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Remover variável"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6dp"/>
    </LinearLayout>
</LinearLayout>
