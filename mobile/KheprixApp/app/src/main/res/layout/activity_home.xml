<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EDE9DE">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="#A8B89A"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivMenuLateral"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_menu"
                android:scaleType="fitCenter"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/kheprix_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="95dp"
                android:src="@drawable/ic_header_beetle"
                android:scaleType="fitCenter"
                android:alpha="0.7"
                android:contentDescription="Kheprix"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/ivPerfil"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_profile"
                android:scaleType="fitCenter"
                android:contentDescription="Perfil"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/kheprix_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardRegistroRapido"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#EDE9DE"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:src="@drawable/ic_butterfly"
                                android:scaleType="fitCenter"
                                android:alpha="0.65"
                                android:contentDescription="Registro Rápido" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Registro Rápido\nde Ocorrência"
                                android:textSize="15sp"
                                android:textColor="#4A5240"
                                android:fontFamily="serif"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVisualizarEstudos"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#EDE9DE"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:src="@drawable/ic_bee"
                                android:scaleType="fitCenter"
                                android:alpha="0.65"
                                android:contentDescription="Visualizar Estudos" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Visualizar\nEstudos"
                                android:textSize="15sp"
                                android:textColor="#4A5240"
                                android:fontFamily="serif"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardNovoEstudo"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#EDE9DE"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:src="@drawable/ic_ladybug"
                                android:scaleType="fitCenter"
                                android:alpha="0.65"
                                android:contentDescription="Novo Estudo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cadastrar\nNovo Estudo"
                                android:textSize="15sp"
                                android:textColor="#4A5240"
                                android:fontFamily="serif"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardConvites"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#EDE9DE"
                        app:cardElevation="2dp"
                        app:cardCornerRadius="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:src="@drawable/ic_moth"
                                android:scaleType="fitCenter"
                                android:alpha="0.65"
                                android:contentDescription="Convites" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Convites de\nColaboração"
                                android:textSize="15sp"
                                android:textColor="#4A5240"
                                android:fontFamily="serif"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUltimoEstudo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#EDE9DE"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvLabelUltimo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Último\nEstudo"
                            android:textSize="22sp"
                            android:textColor="#4A5240"
                            android:fontFamily="serif"
                            android:letterSpacing="0.05"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvUltimoEstudoNome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Nome do Estudo"
                            android:textSize="16sp"
                            android:textColor="#4A5240"
                            android:fontFamily="monospace"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/tvLabelUltimo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvUltimoEstudoData"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Editado em —"
                            android:textSize="14sp"
                            android:textColor="#4A5240"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/tvLabelUltimo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvUltimoEstudoNome" />

                        <TextView
                            android:id="@+id/tvOfflineCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="0 Registros Offline"
                            android:textSize="15sp"
                            android:textColor="#4A5240"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:visibility="gone"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toEndOf="@id/tvLabelUltimo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvUltimoEstudoData" />

                        <Button
                            android:id="@+id/btnVisualizarUltimo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:text="Visualizar Detalhes"
                            android:textColor="#FFFFFF"
                            android:fontFamily="serif"
                            android:backgroundTint="#6B7A5E"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvOfflineCount" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#EDE9DE"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="#4A5240"
        app:itemIconTint="#6B7A5E"
        app:subheaderColor="#4A5240"
        app:headerLayout="@layout/nav_drawer_header" />

</androidx.drawerlayout.widget.DrawerLayout>
