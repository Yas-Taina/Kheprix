<?xml version="1.0" encoding="utf-8"?>
<!--
    Item da lista de estudos.
    Cada item contém:
      - Nome do estudo + data de criação
      - Ícone colaboradores (somente proprietário)
      - Ícone lixeira (deletar)
      - Botão "Salvar Offline" OU botões "Limpar Armazenamento" + "Atualizar Dados"
    A visibilidade dos botões é controlada pelo adapter.

    SUBSTITUIR ícones:
      ic_placeholder_beetle → ic_delete (lixeira rosa/vinho #B88A8A)
      ic_placeholder_beetle → ic_add_person (silhueta + )
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Linha: Nome + ícones -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nome do estudo -->
        <TextView
            android:id="@+id/tvEstudoNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do Estudo"
            android:textSize="20sp"
            android:textColor="#4A5240"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivColaboradores"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Data de criação -->
        <TextView
            android:id="@+id/tvEstudoData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="31/12/2026"
            android:textSize="15sp"
            android:textColor="#7A9169"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivColaboradores"
            app:layout_constraintTop_toBottomOf="@id/tvEstudoNome"/>

        <!-- Ícone colaboradores (somente proprietário)
             SUBSTITUIR: @drawable/ic_add_person -->
        <ImageView
            android:id="@+id/ivColaboradores"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Colaboradores"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toStartOf="@id/ivDeleteEstudo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"/>

        <!-- Ícone lixeira (deletar)
             SUBSTITUIR: @drawable/ic_delete
             Cor via tint: #B88A8A -->
        <ImageView
            android:id="@+id/ivDeleteEstudo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Deletar estudo"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Botões offline ───────────────────────────────────────────────── -->

    <!-- "Salvar Offline" — visível quando não há dados salvos -->
    <Button
        android:id="@+id/btnSalvarOffline"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="Salvar\nOffline"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:backgroundTint="#6B7A5E"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="visible"/>

    <!-- Linha com 2 botões: "Limpar Armazenamento" e "Atualizar Dados" -->
    <!-- Ambos ocultos por padrão; adapter os exibe quando salvosOffline = true -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnLimparArmazenamento"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Limpar\nArmazenamento"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:backgroundTint="#6B7A5E"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAtualizarDados"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Atualizar\nDados"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:backgroundTint="#6B7A5E"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divisor entre itens -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C8D4BE"
        android:layout_marginTop="12dp"/>

</LinearLayout>
