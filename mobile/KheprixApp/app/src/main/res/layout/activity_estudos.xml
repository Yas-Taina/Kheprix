<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout: Lista de Estudos
    ════════════════════════════════════════════════════
    PLACEHOLDERS — substituir:
    1. @drawable/ic_placeholder_header_beetle → logotipo alado do header
    2. @drawable/ic_menu  → ícone hamburguer (3 linhas)
    3. @drawable/ic_profile → ícone de perfil (círculo + silhueta)
    4. @drawable/ic_filter → ícone funil de filtro
    5. @drawable/ic_divider_ornament → ornamento decorativo horizontal (≈◦◆◦)
    Fontes: fontFamily="serif" → @font/sua_fonte_display (Small Caps)
    ════════════════════════════════════════════════════
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDE9DE">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#A8B89A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Ícone menu lateral
             SUBSTITUIR: @drawable/ic_menu (3 linhas)
             Ex: menu hamburguer vetorial -->
        <ImageView
            android:id="@+id/ivMenuLateral"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Menu lateral"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Logo central (besouro alado)
             SUBSTITUIR: @drawable/kheprix_header_beetle -->
        <ImageView
            android:id="@+id/ivHeaderBeetle"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Kheprix"
            android:alpha="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Ícone perfil
             SUBSTITUIR: @drawable/ic_profile -->
        <ImageView
            android:id="@+id/ivPerfil"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle"
            android:scaleType="fitCenter"
            android:contentDescription="Perfil"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Conteúdo scrollável ────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Título "Estudos" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estudos"
                android:textSize="32sp"
                android:textColor="#4A5240"
                android:fontFamily="serif"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

            <!-- Ornamento decorativo
                 SUBSTITUIR: por @drawable/ic_divider_ornament
                 (linha horizontal com florzinha central, como no design)
                 Pode ser um ImageView com um SVG ornamental -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>

            <!-- Botão "Adicionar Estudo ⊕" -->
            <Button
                android:id="@+id/btnAdicionarEstudo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Adicionar Estudo  ⊕"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"/>

            <!-- Ícone funil de filtro (alinhado à direita)
                 SUBSTITUIR: @drawable/ic_filter (funil)
                 Cor: #B88A8A (rosa/vinho do design) -->
            <ImageView
                android:id="@+id/btnFiltrar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_placeholder_beetle"
                android:scaleType="fitCenter"
                android:contentDescription="Filtrar"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <!-- ProgressBar global da lista -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"/>

            <!-- Lista de estudos via RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEstudos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
