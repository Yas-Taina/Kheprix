<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_nova_campanha.xml (versão atualizada)
    Campos: Data início (com ícone calendário), Variáveis (dinâmicas), Descrição, Confirmar.
    O campo "Nome" foi mantido como primeiro campo.

    SUBSTITUIR:
    - ic_placeholder_beetle → ic_calendar (ícone calendário, #6B7A5E)
      Deve abrir um DatePickerDialog ao clicar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/ivBack"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <!-- ivPerfil oculto (mantido para binding) -->
        <View android:id="@+id/ivPerfil"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="100dp">

            <TextView android:id="@+id/tvTitulo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nova Campanha" android:textSize="28sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center" android:layout_marginTop="20dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- Nome da campanha -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Nome:" android:textSize="15sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <EditText android:id="@+id/etNome"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="#4A5240" android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>

            <!-- Data de início com ícone calendário -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Data de início:" android:textSize="15sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="16dp">

                <EditText android:id="@+id/etDataInicio"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/bg_field_green"
                    android:paddingStart="12dp" android:paddingEnd="48dp"
                    android:textColor="#4A5240" android:hint="31/12/2026"
                    android:focusable="false" android:clickable="true"
                    android:inputType="none" android:textCursorDrawable="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!--
                    Ícone calendário — SUBSTITUIR: @drawable/ic_calendar
                    Abre DatePickerDialog ao clicar
                -->
                <ImageView android:id="@+id/ivCalendario"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_placeholder_beetle"
                    android:scaleType="fitCenter"
                    android:contentDescription="Abrir calendário"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="8dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Seção variáveis (preenchida dinamicamente pelo Activity) -->
            <TextView android:id="@+id/tvVariaveisTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Variáveis:" android:textSize="16sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace" android:visibility="gone"/>

            <!--
                Container dinâmico de campos de variáveis.
                Cada campo EditText é adicionado programaticamente por NovaCampanhaActivityV2
                ao carregar as variáveis de nível "campanha" do estudo.
                Ao lado de cada campo é exibida a unidade/métrica da variável (ex: °C).
            -->
            <LinearLayout android:id="@+id/layoutVariaveis"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="12dp"/>

            <!-- Descrição -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Descrição:" android:textSize="15sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>
            <EditText android:id="@+id/etDescricao"
                android:layout_width="match_parent" android:layout_height="120dp"
                android:inputType="textMultiLine" android:gravity="top"
                android:background="@drawable/bg_field_green"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp"
                android:textColor="#4A5240" android:hint="Placeholder"
                android:layout_marginTop="4dp"/>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnConfirmar"
        android:layout_width="wrap_content" android:layout_height="52dp"
        android:text="Confirmar" android:textColor="#FFFFFF" android:fontFamily="serif"
        android:backgroundTint="#6B7A5E"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>
</LinearLayout>
