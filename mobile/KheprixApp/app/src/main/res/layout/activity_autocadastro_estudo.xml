<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_autocadastro_estudo.xml
    Campos: Código (com ícone QR scan) + Senha + botão Confirmar

    SUBSTITUIR ic_placeholder_beetle → ic_qr_scan
    (ícone de scan: quadrado com cantos marcados, estilo do design)
    Tamanho recomendado: 40×40dp, cor #6B7A5E
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="60dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Autocadastro em Estudo"
                android:textSize="28sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:layout_marginTop="24dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp" android:layout_marginBottom="32dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- Label Código -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Código:"
                android:textSize="17sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <!-- Campo Código + ícone QR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="24dp">

                <EditText android:id="@+id/etCodigo"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/bg_field_green"
                    android:paddingStart="12dp" android:paddingEnd="52dp"
                    android:textColor="#4A5240" android:inputType="text"
                    android:textCursorDrawable="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!--
                    Ícone de scan QR
                    SUBSTITUIR: @drawable/ic_qr_scan
                    (quadrado com cantos marcados para indicar scan)
                    Cor: #6B7A5E
                -->
                <ImageView android:id="@+id/ivScanQr"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_placeholder_beetle"
                    android:scaleType="fitCenter"
                    android:contentDescription="Escanear QR Code"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="8dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Label Senha -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Senha"
                android:textSize="17sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <EditText android:id="@+id/etSenha"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_field_green"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:inputType="textPassword"
                android:textColor="#4A5240" android:textCursorDrawable="@null"
                android:layout_marginTop="4dp" android:layout_marginBottom="32dp"/>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_gravity="center"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnConfirmar"
                android:layout_width="wrap_content" android:layout_height="52dp"
                android:text="Confirmar" android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
