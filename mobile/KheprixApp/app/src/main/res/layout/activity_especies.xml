<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_especies.xml
    Lista de espécies: título duplo, botão + filtro, RecyclerView
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">

        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="32dp">

            <TextView android:id="@+id/tvEstudoNome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nome do Estudo"
                android:textSize="18sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center"
                android:layout_marginTop="16dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Espécies"
                android:textSize="30sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center"
                android:layout_marginTop="4dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- Botão Adicionar + Filtrar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button android:id="@+id/btnAdicionarEspecie"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:text="Adicionar Espécie  ⊕"
                    android:textColor="#FFFFFF" android:fontFamily="serif"
                    android:backgroundTint="#6B7A5E"/>

                <!-- SUBSTITUIR: @drawable/ic_filter -->
                <ImageView android:id="@+id/btnFiltrar"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
                    android:contentDescription="Filtrar"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEspecies"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
