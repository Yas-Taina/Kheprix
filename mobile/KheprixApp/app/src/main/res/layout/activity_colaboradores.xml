<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_colaboradores.xml
    3 seções:
      1. "Convidar Colaboradores" — e-mail + botão
      2. Lista de colaboradores (RecyclerView)
      3. "Configurar Autocadastro" — QR Code + código + senha + botão

    SUBSTITUIR:
    - ivQrCode: gerado em código; placeholder mostra ic_placeholder_beetle
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EDE9DE">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#A8B89A" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/ivMenuLateral"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/ic_placeholder_beetle" android:alpha="0.7"
            android:contentDescription="Kheprix" android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView android:id="@+id/ivPerfil"
            android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_placeholder_beetle" android:scaleType="fitCenter"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Perfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="40dp">

            <!-- Nome do estudo (subtítulo) -->
            <TextView android:id="@+id/tvEstudoNome"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="15sp" android:textColor="#7A9169"
                android:fontFamily="monospace" android:gravity="center"
                android:layout_marginTop="12dp"/>

            <!-- ══ SEÇÃO 1: Convidar ══════════════════════════════════════ -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Convidar Colaboradores"
                android:textSize="26sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:layout_marginTop="8dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="6dp" android:layout_marginBottom="16dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="E-mail do usuário:"
                android:textSize="15sp" android:textColor="#6B7A5E"
                android:fontFamily="monospace"/>

            <EditText android:id="@+id/etEmailConvite"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_field_green"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="#4A5240" android:textCursorDrawable="@null"
                android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>

            <Button android:id="@+id/btnAdicionarColaboradores"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Confirmar" android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"/>

            <!-- Ornamento divisor -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            
            <!-- ══ SEÇÃO 1b: Convites Pendentes ════════════════════════ -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A" android:layout_marginBottom="16dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Convites Pendentes"
                android:textSize="20sp" android:textColor="#4A5240"
                android:fontFamily="serif"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A" android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>

            <TextView android:id="@+id/tvSemConvitesPendentes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nenhum convite pendente"
                android:textSize="14sp" android:textColor="#7A9169"
                android:fontFamily="monospace" android:gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/layoutConvitesPendentes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="20dp"/>

            <!-- ══ SEÇÃO 2: Lista de Colaboradores ═══════════════════════ -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Colaboradores do Estudo"
                android:textSize="26sp" android:textColor="#4A5240"
                android:fontFamily="serif"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginTop="6dp" android:layout_marginBottom="12dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvColaboradores"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp"/>

            <!-- Ornamento divisor -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#9AAB8A"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="24dp" android:layout_marginEnd="24dp"/>

            <!-- ══ SEÇÃO 3: Configurar Autocadastro ═══════════════════════ -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Configurar Autocadastro de Colaborador"
                android:textSize="22sp" android:textColor="#4A5240"
                android:fontFamily="serif" android:gravity="center"/>

            <!-- QR Code + código ao lado -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <!--
                    QR Code gerado em código via ZXing.
                    SUBSTITUIR bitmap gerado pelo Activity.
                    Até gerar, mostra ic_placeholder_beetle.
                -->
                <ImageView android:id="@+id/ivQrCode"
                    android:layout_width="130dp" android:layout_height="130dp"
                    android:src="@drawable/ic_placeholder_beetle"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR Code do estudo"/>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Código do Estudo:"
                        android:textSize="14sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>

                    <TextView android:id="@+id/tvCodigoEstudo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="16sp" android:textColor="#4A5240"
                        android:fontFamily="monospace" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Senha"
                        android:textSize="14sp" android:textColor="#6B7A5E"
                        android:fontFamily="monospace"/>

                    <EditText android:id="@+id/etSenhaAutocadastro"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:background="@drawable/bg_field_green"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:textColor="#4A5240" android:textCursorDrawable="@null"
                        android:inputType="textVisiblePassword"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnAlterarSenha"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Alterar Senha" android:textColor="#FFFFFF" android:fontFamily="serif"
                android:backgroundTint="#6B7A5E"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
